# ==============================================================
# DevOps Suite — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ==============================================================

# Backend API base URL (must match the backend port in docker-compose.yml)
VITE_API_URL=http://localhost:8082/api

# Backend WebSocket URL
VITE_WS_URL=http://localhost:8082/ws

# Google OAuth2 client ID — must match GOOGLE_CLIENT_ID in the root .env
# Get it from: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth2 client ID — must match GITHUB_CLIENT_ID in the root .env
# Get it from: https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=
