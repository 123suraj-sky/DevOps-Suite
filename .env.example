# ==============================================================
# DevOps Suite — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ==============================================================

# --------------------------------------------------------------
# PostgreSQL Database
# --------------------------------------------------------------
DB_PASSWORD=password                          # Change in production

# --------------------------------------------------------------
# JWT (must be ≥ 256 bits / 32 chars for HS256)
# Generate a strong secret: openssl rand -hex 32
# --------------------------------------------------------------
JWT_SECRET=devops-suite-jwt-secret-key-minimum-256-bits-for-hs256-algorithm

# --------------------------------------------------------------
# Google OAuth2 (optional — leave blank to disable)
# Get credentials at: https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:8081/login/oauth2/code/google
# --------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vite exposes this to the React frontend (must match GOOGLE_CLIENT_ID above)
VITE_GOOGLE_CLIENT_ID=

# --------------------------------------------------------------
# GitHub OAuth2 (optional — leave blank to disable)
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:5173/auth/github/callback
# --------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Vite exposes this to the React frontend (must match GITHUB_CLIENT_ID above)
VITE_GITHUB_CLIENT_ID=

# --------------------------------------------------------------
# SMTP — Email (optional — required only for password reset & notifications)
#
# Option 1 — Brevo (recommended, 300 emails/day free, no domain needed)
#   Sign up: https://app.brevo.com → SMTP & API → SMTP tab
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<your-brevo-login-email>
#   MAIL_PASSWORD=<generated-smtp-key>
#
# Option 2 — Gmail App Password (easiest, personal use)
#   Generate at: https://myaccount.google.com/apppasswords (requires 2FA)
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your.gmail@gmail.com
#   MAIL_PASSWORD=<16-char app password>
#
# Option 3 — Resend (3,000/mo free, requires a verified custom domain)
#   Sign up: https://resend.com
#   MAIL_HOST=smtp.resend.dev
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=<api-key>
#
# Leave MAIL_HOST blank to disable email entirely (app still works).
# --------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --------------------------------------------------------------
# Admin Observability Access (nginx Basic Auth)
# Protects Grafana (:8080) and Kibana (:8083) behind HTTP Basic Auth.
# ADMIN_PASSWORD is REQUIRED — the htpasswd-init container will fail
# to start if it is not set.
# Generate a strong password: openssl rand -base64 16
# --------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=admin                          # Change in production

# --------------------------------------------------------------
# Admin seed account — created by DataSeeder on first startup
# Set all three to secure, non-default values before deploying to production.
# Leave ADMIN_SEED_PASSWORD blank to disable seeding entirely (recommended for prod
# once the admin account has been created and the password changed).
# --------------------------------------------------------------
ADMIN_SEED_EMAIL=admin@devopssuite.example.com   # Change in production
ADMIN_SEED_PASSWORD=                             # Set a strong password in production
ADMIN_SEED_NAME=Administrator

# --------------------------------------------------------------
# Grafana dashboard admin password
# Used for Grafana's own internal admin account (separate from the
# nginx Basic Auth layer above).
# --------------------------------------------------------------
GRAFANA_PASSWORD=admin

# --------------------------------------------------------------
# Docker Sandbox — Code Execution
# --------------------------------------------------------------
# DOCKER_HOST_TEMP_DIR: Absolute HOST path that the Docker daemon can reach
# for bind-mounting sandbox workspaces. Required when the backend runs inside
# Docker Compose (DinD pattern). Leave blank for native local dev.
#
# How to set:
#   Linux/Mac:   DOCKER_HOST_TEMP_DIR=/absolute/path/to/DevOps Suite/sandbox-temp
#   Windows:     DOCKER_HOST_TEMP_DIR=C:\Users\you\Projects\DevOps Suite\sandbox-temp
#
# The ./sandbox-temp directory is created automatically on first run.
DOCKER_HOST_TEMP_DIR=

# Frontend base URL — used in password reset emails
# Change to your public domain in production (e.g. https://app.devopssuite.com)
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------------
# Elasticsearch (resolved automatically in Docker Compose)
# Only override if connecting to an external ES cluster.
# --------------------------------------------------------------
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# --------------------------------------------------------------
# Redis rate limiting — requests per 60-second window, per identity
# (identity = userId for authenticated requests, IP for anonymous)
# These are optional — defaults shown below are used if not set.
# --------------------------------------------------------------
RATE_LIMIT_EXECUTION_MAX=10    # /api/code-execution/run  — most restrictive
RATE_LIMIT_AUTH_MAX=20         # /api/auth/login|register — brute-force guard
RATE_LIMIT_API_MAX=300         # all other API endpoints  — general limit
