# ==============================================================
# DevOps Suite — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ==============================================================

# --------------------------------------------------------------
# PostgreSQL Database
# --------------------------------------------------------------
DB_PASSWORD=password                          # Change in production

# --------------------------------------------------------------
# JWT (must be ≥ 256 bits / 32 chars for HS256)
# Generate a strong secret: openssl rand -hex 32
# --------------------------------------------------------------
JWT_SECRET=devops-suite-jwt-secret-key-minimum-256-bits-for-hs256-algorithm

# --------------------------------------------------------------
# Google OAuth2 (optional — leave blank to disable)
# Get credentials at: https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:8081/login/oauth2/code/google
# --------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------------------
# SMTP — Email (optional — required only for password reset)
# For dev, use Mailtrap: https://mailtrap.io
# For production, use SendGrid / SES / Gmail App Password
# --------------------------------------------------------------
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@devopssuite.local

# --------------------------------------------------------------
# Admin Observability Access (nginx Basic Auth)
# Protects Grafana (:8080) and Kibana (:8083) behind HTTP Basic Auth.
# ADMIN_PASSWORD is REQUIRED — the htpasswd-init container will fail
# to start if it is not set.
# Generate a strong password: openssl rand -base64 16
# --------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=admin                          # Change in production

# --------------------------------------------------------------
# Grafana dashboard admin password
# Used for Grafana's own internal admin account (separate from the
# nginx Basic Auth layer above).
# --------------------------------------------------------------
GRAFANA_PASSWORD=admin

# --------------------------------------------------------------
# Docker Sandbox — Code Execution
# --------------------------------------------------------------
# DOCKER_HOST_TEMP_DIR: Absolute HOST path that the Docker daemon can reach
# for bind-mounting sandbox workspaces. Required when the backend runs inside
# Docker Compose (DinD pattern). Leave blank for native local dev.
#
# How to set:
#   Linux/Mac:   DOCKER_HOST_TEMP_DIR=/absolute/path/to/DevOps Suite/sandbox-temp
#   Windows:     DOCKER_HOST_TEMP_DIR=C:\Users\you\Projects\DevOps Suite\sandbox-temp
#
# The ./sandbox-temp directory is created automatically on first run.
DOCKER_HOST_TEMP_DIR=

# --------------------------------------------------------------
# Elasticsearch (resolved automatically in Docker Compose)
# Only override if connecting to an external ES cluster.
# --------------------------------------------------------------
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# --------------------------------------------------------------
# Redis rate limiting — requests per 60-second window, per identity
# (identity = userId for authenticated requests, IP for anonymous)
# These are optional — defaults shown below are used if not set.
# --------------------------------------------------------------
RATE_LIMIT_EXECUTION_MAX=10    # /api/code-execution/run  — most restrictive
RATE_LIMIT_AUTH_MAX=20         # /api/auth/login|register — brute-force guard
RATE_LIMIT_API_MAX=300         # all other API endpoints  — general limit
